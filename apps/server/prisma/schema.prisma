generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Category {
    id        String   @id @default(uuid())
    name      String
    slug      String   @unique
    createdAt DateTime @default(now()) @map("created_at")

    @@map("categories")
}

model Unit {
    id           String   @id @default(uuid())
    name         String
    abbreviation String
    createdAt    DateTime @default(now()) @map("created_at")

    @@map("units")
}

model Branch {
    id        String   @id @default(uuid())
    name      String
    address   String
    phone     String
    createdAt DateTime @default(now()) @map("created_at")

    @@map("branches")
}
