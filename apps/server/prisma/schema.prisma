generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Category {
    id        String    @id @default(uuid())
    name      String
    slug      String    @unique
    createdAt DateTime  @default(now()) @map("created_at")
    products  Product[]

    @@map("categories")
}

model Unit {
    id           String    @id @default(uuid())
    name         String
    abbreviation String
    createdAt    DateTime  @default(now()) @map("created_at")
    products     Product[]

    @@map("units")
}

model Branch {
    id        String   @id @default(uuid())
    name      String
    address   String
    phone     String
    createdAt DateTime @default(now()) @map("created_at")

    @@map("branches")
}

model Product {
    id              String   @id @default(uuid())
    name            String
    categoryId      String
    category        Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
    unitId          String
    unit            Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)
    hasTax          Boolean  @default(true)
    priceWithoutTax Decimal  @db.Decimal(10, 2)
    imageUrl        String?
    createdAt       DateTime @default(now()) @map("created_at")

    @@map("products")
}
